{
  "Function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:params})${3: : ${4:int}} {",
      "\t$0",
      "}"
    ],
    "description": "Define a new function"
  },
  "Let Variable": {
    "prefix": "let",
    "body": [
      "let ${1:name}${2: : type} = ${3:value};",
      "$0"
    ],
    "description": "Declare a variable"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for (${1:let i = 0}; ${2:i < 10}; ${3:i += 1}) {",
      "\t$0",
      "}"
    ],
    "description": "Standard for loop"
  },
  "For-In Loop": {
    "prefix": "forin",
    "body": [
      "for ${1:item} in ${2:iterable} {",
      "\t$0",
      "}"
    ],
    "description": "Iterate over an array or slice"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t$0",
      "} else {",
      "\t",
      "}"
    ],
    "description": "If-Else conditional"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "While loop"
  },
  "Hot Region": {
    "prefix": "hot",
    "body": [
      "hot {",
      "\t$0",
      "}"
    ],
    "description": "Performance-critical hot region"
  },
  "Epoch": {
    "prefix": "epoch",
    "body": [
      "epoch {",
      "\t$0",
      "}"
    ],
    "description": "Arena rollback scope: frees everything allocated inside on exit"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:type},",
      "$0",
      "}"
    ],
    "description": "Define a struct"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "import \"${1:module}\";",
      "$0"
    ],
    "description": "Import declarations from another file or package"
  },
  "New Array": {
    "prefix": "new",
    "body": [
      "let ${1:buf} = new ${2:int}[${3:n}];",
      "$0"
    ],
    "description": "Allocate a zeroed, runtime-sized array in the arena"
  },
  "Break": {
    "prefix": "break",
    "body": "break;",
    "description": "Exit the innermost loop"
  },
  "Continue": {
    "prefix": "continue",
    "body": "continue;",
    "description": "Skip to the next loop iteration"
  },
  "Print Statement": {
    "prefix": "print",
    "body": [
      "print ${1:value};",
      "$0"
    ],
    "description": "Print one or more comma-separated values to console"
  }
}
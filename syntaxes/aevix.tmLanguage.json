{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aevix",
  "scopeName": "source.aevix",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#func-def" },
    { "include": "#struct-def" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#struct-literal" },
    { "include": "#user-types" },
    { "include": "#builtins" },
    { "include": "#func-call" },
    { "include": "#member-access" },
    { "include": "#variables" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.aevix",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.aevix",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.aevix",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.aevix",
              "match": "\\\\n|\\\\t|\\\\r|\\\\\\\\|\\\\\""
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.aevix",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.aevix",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "func-def": {
      "patterns": [
        {
          "name": "meta.function.aevix",
          "begin": "\\b(func)\\s+([a-zA-Z_]\\w*)\\s*\\(",
          "beginCaptures": {
            "1": { "name": "keyword.other.aevix" },
            "2": { "name": "entity.name.function.aevix" }
          },
          "end": "(?=\\{)",
          "patterns": [
            {
              "name": "variable.parameter.aevix",
              "match": "\\b([a-zA-Z_]\\w*)(?=\\s*:)"
            },
            {
              "match": "\\)\\s*:\\s*([a-zA-Z_]\\w*(?:\\s*\\[\\s*[0-9]*\\s*\\])?)",
              "captures": {
                "1": { "name": "support.type.aevix" }
              }
            },
            { "include": "#types" },
            { "include": "#user-types" },
            { "include": "#numbers" },
            { "name": "punctuation.separator.aevix", "match": "," },
            { "name": "punctuation.definition.type.aevix", "match": ":" },
            { "name": "punctuation.definition.parameters.aevix", "match": "\\(|\\)" }
          ]
        }
      ]
    },
    "struct-def": {
      "patterns": [
        {
          "name": "meta.struct.aevix",
          "begin": "\\b(struct)\\s+([a-zA-Z_]\\w*)",
          "beginCaptures": {
            "1": { "name": "keyword.other.aevix" },
            "2": { "name": "entity.name.type.aevix" }
          },
          "end": "(?=\\})",
          "patterns": [
            {
              "name": "variable.other.member.aevix",
              "match": "\\b([a-zA-Z_]\\w*)(?=\\s*:)"
            },
            { "include": "#comments" },
            { "include": "#types" },
            { "include": "#user-types" },
            { "name": "punctuation.separator.aevix", "match": "," },
            { "name": "punctuation.definition.type.aevix", "match": ":" }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "constant.language.boolean.aevix",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "keyword.control.aevix",
          "match": "\\b(if|else|while|for|in|return|break|continue|hot|epoch)\\b"
        },
        {
          "name": "keyword.control.import.aevix",
          "match": "\\b(import)\\b"
        },
        {
          "name": "keyword.other.aevix",
          "match": "\\b(let|func|struct|print|new)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.array.aevix",
          "match": "\\b(int|float|bool|string)\\s*\\[\\s*[0-9]*\\s*\\]"
        },
        {
          "name": "support.type.aevix",
          "match": "\\b(int|float|bool|string)\\b"
        }
      ]
    },
    "struct-literal": {
      "patterns": [
        {
          "name": "entity.name.type.aevix",
          "match": "\\b([A-Z]\\w*)(?=\\s*\\{)"
        }
      ]
    },
    "user-types": {
      "patterns": [
        {
          "name": "support.type.aevix",
          "match": "\\b([A-Z]\\w*)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.aevix",
          "match": "\\b(len|argc|arg|read|write|input|to_int|to_float|to_str|substr|split|min|max|abs|exit)(?=\\s*\\()"
        }
      ]
    },
    "func-call": {
      "patterns": [
        {
          "name": "entity.name.function.aevix",
          "match": "\\b([a-zA-Z_]\\w*)(?=\\s*\\()"
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "match": "(?<=\\.)\\s*([a-zA-Z_]\\w*)",
          "captures": {
            "1": { "name": "variable.other.member.aevix" }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.aevix",
          "match": "\\b[a-zA-Z_]\\w*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.aevix",
          "match": "\\+=|-=|\\*=|/="
        },
        {
          "name": "keyword.operator.comparison.aevix",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.aevix",
          "match": "\\+|-|\\*|/"
        },
        {
          "name": "keyword.operator.logical.aevix",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.aevix",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.definition.begin.brace.aevix", "match": "\\{" },
        { "name": "punctuation.definition.end.brace.aevix", "match": "\\}" },
        { "name": "punctuation.definition.begin.bracket.aevix", "match": "\\[" },
        { "name": "punctuation.definition.end.bracket.aevix", "match": "\\]" },
        { "name": "punctuation.definition.begin.paren.aevix", "match": "\\(" },
        { "name": "punctuation.definition.end.paren.aevix", "match": "\\)" },
        { "name": "punctuation.terminator.statement.aevix", "match": ";" },
        { "name": "punctuation.separator.comma.aevix", "match": "," },
        { "name": "punctuation.definition.type.aevix", "match": ":" }
      ]
    }
  }
}